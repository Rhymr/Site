# Copy to .env and fill in once you can reach your Stripe account.
# Everything here is read at startup; nothing is committed.

# --- Stripe -----------------------------------------------------------------
# Dashboard > Developers > API keys. Use the TEST key (sk_test_...) until launch.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret. Local: run `npm run stripe:listen` and copy the
# whsec_... it prints. Production: Dashboard > Developers > Webhooks > your
# endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- This service ---------------------------------------------------------
PORT=4242

# The public site, used for CORS and for the Checkout success/cancel returns.
SITE_URL=http://localhost:8000

# Where a paid customer is sent after payment. {CHECKOUT_SESSION_ID} is
# substituted by Stripe. Point at a "thank you / your download" page.
SUCCESS_PATH=/thanks.html?s={CHECKOUT_SESSION_ID}
CANCEL_PATH=/#pricing

# --- Fulfilment (fill in when there's a build to hand over) --------------
# A link the buyer receives after payment. Use a time-limited / signed URL
# (S3, R2, Bunny, etc). Leave blank to just log the sale for now.
DOWNLOAD_URL=

# Minimum price in cents. $5.00 = 500. Stripe enforces this at Checkout.
MIN_AMOUNT_CENTS=500
PRESET_AMOUNT_CENTS=500
